[Unit]
Description=Holos33 MCP content-sync (holos33.com naar /srv/holos33-mcp-content)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=holos33sync
Group=holos33
WorkingDirectory=/opt/holos33-mcp/app
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/tmp
Environment=HOLOS33_MCP_CONTENT=/srv/holos33-mcp-content
Environment=HOLOS33_FACTS=/opt/holos33-mcp/app/facts
Environment=HOLOS33_SYNC_LOG=/var/log/holos33-mcp/sync.jsonl
ExecStart=/usr/bin/python3 /opt/holos33-mcp/app/sync/holos33_sync.py
TimeoutStartSec=15min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0022
ReadWritePaths=/srv/holos33-mcp-content /var/log/holos33-mcp
CPUQuota=50%
MemoryMax=512M
